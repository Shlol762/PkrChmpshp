rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is signed in as an Admin (with email/password)
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Helper: Verify if the balances map conforms to the nested {bank, wallet} schema
    function isValidBalancesSchema(balances) {
      return balances.keys().size() == 0 || 
             (balances[balances.keys()[0]] is map && 
              'bank' in balances[balances.keys()[0]] && 
              'wallet' in balances[balances.keys()[0]]);
    }

    // Helper: Check if a single player balance change is valid (Unchanged OR Buy-in OR Cash-out)
    function isPlayerBalanceValid(before, after, key) {
      return (float(after[key].bank) == float(before[key].bank) && float(after[key].wallet) == float(before[key].wallet)) ||
             (float(after[key].bank) < float(before[key].bank) && (float(after[key].bank) + float(after[key].wallet) == float(before[key].bank) + float(before[key].wallet))) ||
             (float(after[key].bank) == float(before[key].bank) && float(after[key].wallet) == 0.0);
    }

    // Helper: Checks if all player changes are either no-change, valid buy-in, or valid cash-out
    function isEveryPlayerChangeValid(before, after, keys) {
      return (keys.size() > 0 ? isPlayerBalanceValid(before, after, keys[0]) : true) &&
             (keys.size() > 1 ? isPlayerBalanceValid(before, after, keys[1]) : true) &&
             (keys.size() > 2 ? isPlayerBalanceValid(before, after, keys[2]) : true) &&
             (keys.size() > 3 ? isPlayerBalanceValid(before, after, keys[3]) : true) &&
             (keys.size() > 4 ? isPlayerBalanceValid(before, after, keys[4]) : true) &&
             (keys.size() > 5 ? isPlayerBalanceValid(before, after, keys[5]) : true) &&
             (keys.size() > 6 ? isPlayerBalanceValid(before, after, keys[6]) : true) &&
             (keys.size() > 7 ? isPlayerBalanceValid(before, after, keys[7]) : true) &&
             (keys.size() > 8 ? isPlayerBalanceValid(before, after, keys[8]) : true) &&
             (keys.size() > 9 ? isPlayerBalanceValid(before, after, keys[9]) : true) &&
             (keys.size() > 10 ? isPlayerBalanceValid(before, after, keys[10]) : true) &&
             (keys.size() > 11 ? isPlayerBalanceValid(before, after, keys[11]) : true) &&
             (keys.size() > 12 ? isPlayerBalanceValid(before, after, keys[12]) : true) &&
             (keys.size() > 13 ? isPlayerBalanceValid(before, after, keys[13]) : true) &&
             (keys.size() > 14 ? isPlayerBalanceValid(before, after, keys[14]) : true) &&
             (keys.size() > 15 ? isPlayerBalanceValid(before, after, keys[15]) : true);
    }

    // Helper: Calculates the total balance sum across all players (supports up to 16 players)
    function totalBalanceSum(balances, keys) {
      return (keys.size() > 0 ? (float(balances[keys[0]].bank) + float(balances[keys[0]].wallet)) : 0.0) +
             (keys.size() > 1 ? (float(balances[keys[1]].bank) + float(balances[keys[1]].wallet)) : 0.0) +
             (keys.size() > 2 ? (float(balances[keys[2]].bank) + float(balances[keys[2]].wallet)) : 0.0) +
             (keys.size() > 3 ? (float(balances[keys[3]].bank) + float(balances[keys[3]].wallet)) : 0.0) +
             (keys.size() > 4 ? (float(balances[keys[4]].bank) + float(balances[keys[4]].wallet)) : 0.0) +
             (keys.size() > 5 ? (float(balances[keys[5]].bank) + float(balances[keys[5]].wallet)) : 0.0) +
             (keys.size() > 6 ? (float(balances[keys[6]].bank) + float(balances[keys[6]].wallet)) : 0.0) +
             (keys.size() > 7 ? (float(balances[keys[7]].bank) + float(balances[keys[7]].wallet)) : 0.0) +
             (keys.size() > 8 ? (float(balances[keys[8]].bank) + float(balances[keys[8]].wallet)) : 0.0) +
             (keys.size() > 9 ? (float(balances[keys[9]].bank) + float(balances[keys[9]].wallet)) : 0.0) +
             (keys.size() > 10 ? (float(balances[keys[10]].bank) + float(balances[keys[10]].wallet)) : 0.0) +
             (keys.size() > 11 ? (float(balances[keys[11]].bank) + float(balances[keys[11]].wallet)) : 0.0) +
             (keys.size() > 12 ? (float(balances[keys[12]].bank) + float(balances[keys[12]].wallet)) : 0.0) +
             (keys.size() > 13 ? (float(balances[keys[13]].bank) + float(balances[keys[13]].wallet)) : 0.0) +
             (keys.size() > 14 ? (float(balances[keys[14]].bank) + float(balances[keys[14]].wallet)) : 0.0) +
             (keys.size() > 15 ? (float(balances[keys[15]].bank) + float(balances[keys[15]].wallet)) : 0.0);
    }

    // 1. Private data (PINs) - Admin only
    match /privateData/{document=**} {
      allow read, write: if isAdmin();
    }

    // 2. Configurations & Ledgers
    match /artifacts/{appId}/public/data/config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/sessions/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/balances/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.auth != null && (
        isAdmin() || (
          isValidBalancesSchema(request.resource.data) && (
            isEveryPlayerChangeValid(resource.data, request.resource.data, resource.data.keys()) ||
            totalBalanceSum(resource.data, resource.data.keys()) == totalBalanceSum(request.resource.data, resource.data.keys())
          )
        )
      );
    }

    // 3. Loans (Read/writeable by authenticated users)
    match /artifacts/{appId}/public/data/loans/{docId} {
      allow read, write: if request.auth != null;
    }

    // 3b. Live Game State (Read by everyone, written by Admin only)
    match /artifacts/{appId}/public/data/liveGame/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3c. Transactions Log (Read by everyone, written by authenticated users)
    match /artifacts/{appId}/public/data/transactions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Seat Claims verification (Anyone authenticated can write/read their claim)
    match /artifacts/{appId}/public/data/playerClaims/{playerId} {
      allow read, write: if request.auth != null;
    }

    // 4b. Player Declarations (Read by anyone, writeable by authenticated users)
    match /artifacts/{appId}/public/data/playerDeclarations/{playerId} {
      allow read, write: if request.auth != null;
    }

    // 5. Live Game Commands (Only authenticated users can submit a command)
    match /artifacts/{appId}/public/data/liveGameCommands/{commandId} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null;
    }
  }
}
