rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is signed in as an Admin (with email/password)
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Helper: Verify if the balances map conforms to the nested {bank, wallet} schema
    function isValidBalancesSchema(balances) {
      return balances.keys().size() == 0 || 
             (balances[balances.keys()[0]] is map && 
              balances[balances.keys()[0]].keys().hasAll(['bank', 'wallet']));
    }

    // Helper: Get player balance (bank + wallet) safely
    function getPlayerBalance(data, keys, idx) {
      return idx < keys.size() ? (data[keys[idx]].bank + data[keys[idx]].wallet) : 0;
    }

    // Helper: Verify if the total sum of balances remains unchanged (zero-sum)
    function isSumEqual(before, after, keys) {
      return (
        getPlayerBalance(before, keys, 0) + getPlayerBalance(before, keys, 1) +
        getPlayerBalance(before, keys, 2) + getPlayerBalance(before, keys, 3) +
        getPlayerBalance(before, keys, 4) + getPlayerBalance(before, keys, 5) +
        getPlayerBalance(before, keys, 6) + getPlayerBalance(before, keys, 7) +
        getPlayerBalance(before, keys, 8) + getPlayerBalance(before, keys, 9) +
        getPlayerBalance(before, keys, 10) + getPlayerBalance(before, keys, 11) +
        getPlayerBalance(before, keys, 12) + getPlayerBalance(before, keys, 13) +
        getPlayerBalance(before, keys, 14) + getPlayerBalance(before, keys, 15)
      ) == (
        getPlayerBalance(after, keys, 0) + getPlayerBalance(after, keys, 1) +
        getPlayerBalance(after, keys, 2) + getPlayerBalance(after, keys, 3) +
        getPlayerBalance(after, keys, 4) + getPlayerBalance(after, keys, 5) +
        getPlayerBalance(after, keys, 6) + getPlayerBalance(after, keys, 7) +
        getPlayerBalance(after, keys, 8) + getPlayerBalance(after, keys, 9) +
        getPlayerBalance(after, keys, 10) + getPlayerBalance(after, keys, 11) +
        getPlayerBalance(after, keys, 12) + getPlayerBalance(after, keys, 13) +
        getPlayerBalance(after, keys, 14) + getPlayerBalance(after, keys, 15)
      );
    }

    // Helper: Check if a single player balance change is a valid cash-out (wallet is 0, bank is unchanged)
    function isPlayerChangeValid(before, after, keys, idx) {
      let key = keys[idx];
      return before[key] == after[key] || 
             (after[key].wallet == 0 && after[key].bank == before[key].bank);
    }

    // Helper: Checks if all player changes are either no-change or valid cash-out
    function isEveryPlayerChangeValid(before, after, keys) {
      return (keys.size() > 0 ? isPlayerChangeValid(before, after, keys, 0) : true) &&
             (keys.size() > 1 ? isPlayerChangeValid(before, after, keys, 1) : true) &&
             (keys.size() > 2 ? isPlayerChangeValid(before, after, keys, 2) : true) &&
             (keys.size() > 3 ? isPlayerChangeValid(before, after, keys, 3) : true) &&
             (keys.size() > 4 ? isPlayerChangeValid(before, after, keys, 4) : true) &&
             (keys.size() > 5 ? isPlayerChangeValid(before, after, keys, 5) : true) &&
             (keys.size() > 6 ? isPlayerChangeValid(before, after, keys, 6) : true) &&
             (keys.size() > 7 ? isPlayerChangeValid(before, after, keys, 7) : true) &&
             (keys.size() > 8 ? isPlayerChangeValid(before, after, keys, 8) : true) &&
             (keys.size() > 9 ? isPlayerChangeValid(before, after, keys, 9) : true) &&
             (keys.size() > 10 ? isPlayerChangeValid(before, after, keys, 10) : true) &&
             (keys.size() > 11 ? isPlayerChangeValid(before, after, keys, 11) : true) &&
             (keys.size() > 12 ? isPlayerChangeValid(before, after, keys, 12) : true) &&
             (keys.size() > 13 ? isPlayerChangeValid(before, after, keys, 13) : true) &&
             (keys.size() > 14 ? isPlayerChangeValid(before, after, keys, 14) : true) &&
             (keys.size() > 15 ? isPlayerChangeValid(before, after, keys, 15) : true);
    }

    // 1. Private data (PINs) - Admin only
    match /privateData/{document=**} {
      allow read, write: if isAdmin();
    }

    // 2. Configurations & Ledgers
    match /artifacts/{appId}/public/data/config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/sessions/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/balances/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.auth != null && (
        isAdmin() || (
          isValidBalancesSchema(request.resource.data) &&
          (isSumEqual(resource.data, request.resource.data, resource.data.keys()) ||
           isEveryPlayerChangeValid(resource.data, request.resource.data, resource.data.keys()))
        )
      );
    }

    // 3. Loans (Read/writeable by authenticated users)
    match /artifacts/{appId}/public/data/loans/{docId} {
      allow read, write: if request.auth != null;
    }

    // 3b. Live Game State (Read by everyone, written by Admin only)
    match /artifacts/{appId}/public/data/liveGame/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3c. Transactions Log (Read by everyone, written by authenticated users)
    match /artifacts/{appId}/public/data/transactions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Seat Claims verification (Anyone authenticated can write/read their claim)
    match /artifacts/{appId}/public/data/playerClaims/{playerId} {
      allow read, write: if request.auth != null;
    }

    // 4b. Player Declarations (Read by anyone, writeable by authenticated users)
    match /artifacts/{appId}/public/data/playerDeclarations/{playerId} {
      allow read, write: if request.auth != null;
    }

    // 5. Live Game Commands (Only authenticated users can submit a command)
    match /artifacts/{appId}/public/data/liveGameCommands/{commandId} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null;
    }
  }
}
